# ============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงของคุณ
# copy this file to ".env" and fill in your real values
# ============================================================================

# ---------- เวอร์ชันของซอฟต์แวร์ (เพื่อให้ติดตั้งซ้ำแล้วได้ผลเหมือนเดิม) ----------
# สำคัญต่องานวิจัย: ควรระบุเวอร์ชันให้ชัดเจน ไม่ปล่อยเป็น latest
# เพราะถ้าผู้ให้บริการปล่อยเวอร์ชันใหม่ ผลการทดสอบที่รายงานไว้อาจทำซ้ำไม่ได้
#
# ดูเวอร์ชันที่กำลังรันอยู่จริงด้วยคำสั่ง (รันหลังระบบทำงานแล้ว):
#   docker exec tax-advisor-n8n n8n --version
#   docker exec tax-advisor-postgres postgres --version
# แล้วนำเลขที่ได้มาใส่แทนค่าด้านล่าง และบันทึกลงรายงานบทที่ 3 หัวข้อเครื่องมือที่ใช้ในการวิจัย
#
# คำเตือน: อย่าเปลี่ยนเลขเวอร์ชันหลักของ PostgreSQL (เช่น 16 -> 17) หลังมีข้อมูลแล้ว
#          เพราะรูปแบบไฟล์ฐานข้อมูลไม่เข้ากัน ต้องทำ dump/restore ก่อน
POSTGRES_VERSION=16-alpine
N8N_VERSION=latest

# ---------- PostgreSQL ----------
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=n8n
APP_DB_NAME=tax_advisor
POSTGRES_PORT=5432

# ---------- n8n ----------
N8N_PORT=5678
N8N_HOST=localhost
# ตอนแรกยังไม่มี ngrok URL ให้ใส่ localhost ไปก่อน แล้วค่อยอัปเดตทีหลัง
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Bangkok

# หมายเหตุ: n8n เวอร์ชันปัจจุบัน (v1+) เลิกใช้ N8N_BASIC_AUTH_USER/PASSWORD แล้ว
# บัญชีล็อกอินหน้า n8n editor จะสร้างผ่านหน้า "Set up owner account" ตอนเปิดเว็บครั้งแรกแทน

# ต้องสุ่มค่าคงที่ 1 ค่า แล้วห้ามเปลี่ยนอีกหลังใช้งานจริง (ใช้เข้ารหัส credentials ใน n8n)
# สร้างได้ด้วยคำสั่ง: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_this_to_a_random_32_char_hex_string

# ---------- pgAdmin (หน้าจอเว็บสำหรับดูฐานข้อมูล เปิดใช้เมื่อต้องการ) ----------
# เปิดใช้ด้วย: docker compose --profile tools up -d pgadmin
# แล้วเข้าที่ http://localhost:5050 โดยล็อกอินด้วยค่าสองบรรทัดนี้
PGADMIN_EMAIL=admin@taxadvisor.local
PGADMIN_PASSWORD=admin1234
PGADMIN_PORT=5050

# ---------- ngrok (ใช้เจาะ tunnel ให้ LINE เรียก webhook ของ n8n ที่รันบนเครื่องได้) ----------
# สมัครฟรีที่ https://dashboard.ngrok.com/signup แล้วนำ authtoken มาใส่
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ---------- LINE Official Account / Messaging API ----------
# ดูได้จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ---------- แบบจำลองภาษา (ตั้งได้หลายตัวเพื่อนำมาเปรียบเทียบกัน) ----------
# ดูวิธีตั้งค่าแต่ละตัวได้ที่ไฟล์ คู่มือเปรียบเทียบโมเดล.md

# 1) OpenAI (มีค่าใช้จ่าย เติมขั้นต่ำ 5 USD)
#    https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2) Google Gemini (โควตาฟรี ไม่ต้องผูกบัตร)
#    https://aistudio.google.com/apikey
#
#    สำคัญ: โควตาฟรีต่างกันมากในแต่ละรุ่น ตรวจสอบก่อนเลือกใช้
#      gemini-2.5-flash       = 20 คำขอต่อวัน    (น้อยเกินไปสำหรับงานนี้)
#      gemini-2.5-flash-lite  = 1,000 คำขอต่อวัน (แนะนำให้ใช้รุ่นนี้)
#    ตรวจโควตาปัจจุบันได้ที่ https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# ชื่อแบบจำลองที่ใช้งานอยู่จริงในระบบ ณ ขณะนี้
# ระบบจะบันทึกค่านี้ลงตาราง conversations ทุกครั้ง เพื่อให้แยกวิเคราะห์ผลตามแบบจำลองได้
# ต้องอัปเดตทุกครั้งที่สลับแบบจำลองใน n8n แล้วรัน:
#   docker compose up -d --force-recreate n8n
ACTIVE_MODEL_NAME=gemini-3-flash-preview

# 3) Typhoon แบบจำลองภาษาไทยของ SCB 10X รันในเครื่องผ่าน Ollama (ฟรี ไม่จำกัดจำนวนครั้ง)
#    ติดตั้ง Ollama จาก https://ollama.com/download แล้วรัน:
#      ollama pull scb10x/typhoon2.5-qwen3-4b
#    หมายเหตุ: ค่าด้านล่างใช้สำหรับสคริปต์เปรียบเทียบที่รันบน Windows โดยตรง
#             ส่วน n8n ที่อยู่ใน container ต้องใช้ http://host.docker.internal:11434 แทน
OLLAMA_BASE_URL=http://localhost:11434
TYPHOON_MODEL=scb10x/typhoon2.5-qwen3-4b

# ---------------------------------------------------------------------------
# รหัส credential ของ n8n (ตั้งครั้งเดียว ช่วยประหยัดเวลาทุกครั้งที่นำเข้าเวิร์กโฟลว์)
# ---------------------------------------------------------------------------
# ทุกครั้งที่ประกอบไฟล์เวิร์กโฟลว์ใหม่แล้วนำเข้า n8n โหนดที่ต้องใช้ credential
# จะขึ้นเตือนว่าขาด แล้วต้องเปิดทีละโหนดไปเลือกใหม่ ซึ่งมี 9 โหนด
#
# ถ้าใส่รหัสจริงไว้ตรงนี้ สคริปต์จะฝังให้อัตโนมัติ นำเข้าแล้วใช้ได้ทันที
#
# วิธีหารหัส เปิด n8n ไปที่เมนู Credentials คลิก credential ที่ต้องการ
# แล้วดูที่แถบที่อยู่ของเบราว์เซอร์
#   http://localhost:5678/home/credentials/AbCdEf123456
#                                          ^^^^^^^^^^^^ นี่คือรหัส
#
# ไม่ใส่ก็ได้ ระบบยังทำงานเหมือนเดิม เพียงแต่ต้องผูก credential ด้วยมือทุกครั้ง
N8N_PG_CREDENTIAL_ID=
N8N_PG_CREDENTIAL_NAME=Tax Advisor Postgres
N8N_LLM_CREDENTIAL_ID=
N8N_LLM_CREDENTIAL_NAME=Google Gemini (Tax Advisor)
