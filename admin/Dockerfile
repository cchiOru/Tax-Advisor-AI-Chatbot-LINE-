# ============================================================================
#  บริการหน้าเว็บหลังบ้านสำหรับผู้ดูแลระบบ
# ----------------------------------------------------------------------------
#  ตรึงเวอร์ชันไว้ทั้งอิมเมจฐานและไลบรารี เพื่อให้ติดตั้งซ้ำได้ผลเหมือนเดิม
#  ซึ่งจำเป็นสำหรับงานที่ต้องทำซ้ำได้ตามหลักการวิจัย
# ============================================================================
FROM node:20.18-alpine

WORKDIR /app

# คัดลอกเฉพาะไฟล์รายการไลบรารีก่อน เพื่อให้ Docker ใช้ cache ชั้นนี้ซ้ำได้
# เวลาแก้โค้ดแล้ว build ใหม่จะไม่ต้องติดตั้งไลบรารีใหม่ทุกครั้ง
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY . .

# รันด้วยผู้ใช้ที่ไม่ใช่ root
# ถ้ามีช่องโหว่ในโค้ด ความเสียหายจะถูกจำกัดอยู่ในขอบเขตของผู้ใช้นี้
USER node

EXPOSE 8080
CMD ["node", "server.js"]
